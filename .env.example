# Copy this file to .env and replace the API key with a long random secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DETECTOR_API_KEY=replace-with-a-long-random-secret

# Per-process API rate limit.
DETECTOR_RATE_LIMIT_REQUESTS=30
DETECTOR_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Caddy HTTPS reverse proxy (DNS A/AAAA must point to this host).
DOMAIN=api.example.com

# Optional Splunk HTTP Event Collector output.
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# Optional Elasticsearch output.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=ai-login-anomaly-detector

# Outbound SIEM request timeout.
SIEM_TIMEOUT_SECONDS=3
